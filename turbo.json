{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "gen:openapi": {
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["@taktikon/api#gen:openapi"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "@taktikon/web#typecheck": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}

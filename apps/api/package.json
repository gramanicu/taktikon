{
  "name": "@taktikon/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:otel": "node --import tsx --import ./src/instrumentation.ts --watch src/server.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env --import tsx db/migrate.ts",
    "auth:generate": "pnpm dlx @better-auth/cli generate --config src/modules/identity/auth.gen-config.ts --output src/modules/identity/auth.table.ts -y"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@hono/zod-openapi": "^1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@opentelemetry/winston-transport": "^0.30.0",
    "better-auth": "^1.6.24",
    "drizzle-orm": "^0.44",
    "hono": "^4",
    "ioredis": "^5",
    "neverthrow": "catalog:",
    "postgres": "^3",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31",
    "testcontainers": "^11",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

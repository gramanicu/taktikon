# Copy to .env (gitignored) for local dev. `pnpm infra:up` provides these services.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://taktikon:taktikon@localhost:5432/taktikon
REDIS_URL=redis://localhost:6379
# Auth signing secret — generate a strong random value (e.g. `openssl rand -base64 32`).
AUTH_SECRET=change-me-to-a-long-random-secret
AUTH_URL=http://localhost:3000
# Pepper for hashing registration emails (enables register/forgot-password). Keep secret.
EMAIL_HASH_PEPPER=change-me-to-a-long-random-pepper

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "#components/*": ["./src/components/*.tsx"],
      "#lib/*": ["./src/lib/*.ts"],
      "#hooks/*": ["./src/hooks/*.ts"]
    }
  },
  "include": [".storybook/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
